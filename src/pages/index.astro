---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { profile, projects, experience, stack, education, courses } from '../data/profile';
const categories = [...new Set(courses.map(c => c.category))];
const featured = courses.filter(c => c.featured);
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Marco Antonio Mamani Mamani, desarrollador Full Stack en El Alto, Bolivia. Angular, NestJS, TypeScript y PostgreSQL. Disponible para trabajar." />
    <meta name="theme-color" content="#0b1720" />
    <meta property="og:title" content="Marco Mamani · Desarrollador Full Stack" />
    <meta property="og:description" content="Aplicaciones web, APIs y sistemas de gestión. Conoce mi experiencia y proyectos. Disponible para trabajar." />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_BO" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>Marco Mamani — Desarrollador Full Stack</title>
    <script is:inline>
      (() => {
        let preference;
        try { preference = localStorage.getItem('theme'); } catch {}
        document.documentElement.dataset.theme = preference === 'light' || preference === 'dark' ? preference : (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="#inicio" aria-label="Marco Mamani, inicio"><span class="brand-mark">m<span>.</span></span><span>marco<span class="muted">mamani</span></span></a>
        <nav id="navigation" aria-label="Navegación principal">
          <a href="#proyectos">Proyectos</a><a href="#experiencia">Experiencia</a><a href="#stack">Stack</a><a href="#formacion">Formación</a>
          <a class="nav-contact" href="#contacto">Hablemos <Icon name="arrow" size={15} /></a>
        </nav>
        <div class="header-actions">
          <button id="theme-toggle" class="icon-button" aria-label="Cambiar tema"><span class="sun-icon"><Icon name="sun" /></span><span class="moon-icon"><Icon name="moon" /></span></button>
          <button id="menu-toggle" class="icon-button menu-toggle" aria-label="Abrir menú" aria-expanded="false" aria-controls="navigation"><Icon name="menu" /></button>
        </div>
      </div>
    </header>

    <main id="contenido">
      <section class="hero container" id="inicio" aria-labelledby="hero-title">
        <div class="hero-copy">
          <div class="hero-identity">
            <img class="profile-photo" src={`${base}marco-mamani.jpg`} alt="Retrato de Marco Antonio Mamani Mamani" width="222" height="222" fetchpriority="high" />
            <div>
              <div class="availability"><span></span> Disponible para trabajar</div>
              <p class="eyebrow hero-intro">HOLA, SOY MARCO ANTONIO</p>
            </div>
          </div>
          <h1 id="hero-title">Transformo ideas<br />en <span>soluciones web.</span></h1>
          <p class="hero-role">Desarrollador Full Stack<span class="role-dot"> / </span><span class="location">El Alto, Bolivia</span></p>
          <p class="hero-description">{profile.summary}</p>
          <div class="hero-actions"><a class="button primary" href="#proyectos">Explorar proyectos <Icon name="right" size={18} /></a><a class="button secondary" href="#contacto">Contactarme <Icon name="arrow" size={17} /></a></div>
          <div class="hero-caption"><span class="tiny-line"></span> Del frontend a la base de datos.</div>
        </div>
        <div class="hero-art" aria-label="Mi stack de desarrollo: Angular y TypeScript, NestJS y Prisma, PostgreSQL">
          <div class="art-grid"></div>
          <div class="orbit orbit-one"></div><div class="orbit orbit-two"></div>
          <span class="art-coordinate">FULL STACK / END TO END</span>
          <div class="architecture">
            <div class="architecture-top"><span class="code-symbol">&lt;/&gt;</span><span>Una idea. Un sistema conectado.</span><span class="window-dots">···</span></div>
            <div class="architecture-layer"><span class="layer-number">01</span><div class="tech-symbol angular">A</div><div><span class="layer-label">LA EXPERIENCIA</span><strong>Angular <span>+ TypeScript</span></strong></div><span class="layer-status"></span></div>
            <div class="connection"><span></span><small>API REST</small></div>
            <div class="architecture-layer"><span class="layer-number">02</span><div class="tech-symbol nest">N</div><div><span class="layer-label">LA LÓGICA</span><strong>NestJS <span>+ Prisma</span></strong></div><span class="layer-status"></span></div>
            <div class="connection"><span></span><small>DATOS RELACIONALES</small></div>
            <div class="architecture-layer"><span class="layer-number">03</span><div class="tech-symbol postgres">P</div><div><span class="layer-label">LA BASE</span><strong>PostgreSQL</strong></div><span class="layer-status"></span></div>
            <div class="architecture-bottom"><span class="mini-dot"></span> Interfaces · APIs · Datos <Icon name="code" size={16} /></div>
          </div>
          <div class="art-tag"><Icon name="layers" size={17} /> Pensado para conectar.</div>
          <span class="art-index">MAMANI / DEV</span>
        </div>
      </section>

      <div class="stack-strip"><div class="container"><span class="strip-label">MI STACK PRINCIPAL</span><div class="strip-technologies">{['Angular', 'NestJS', 'TypeScript', 'PostgreSQL', 'Java'].map((name, i) => <span><i class={`tech-dot tech-${i}`}></i>{name}</span>)}</div><a href="#stack" aria-label="Ver todas mis tecnologías"><Icon name="arrow" size={19} /></a></div></div>

      <section class="section container" id="proyectos" aria-labelledby="projects-title">
        <div class="section-heading"><div><p class="eyebrow">01 / TRABAJO EN PRÁCTICA</p><h2 id="projects-title">Código con un propósito.</h2></div><p>Soluciones para necesidades reales.<br />Del contexto empresarial al sector salud.</p></div>
        <div class="projects-grid">{projects.map(project => <article class="project-card">
          <div class={`project-visual ${project.kind}`} aria-hidden="true"><span class="project-visual-label">{project.category}</span><span class="project-big-number">{project.number}</span><div class="project-glyph">{project.kind === 'reservations' ? <svg viewBox="0 0 120 120" fill="none"><rect x="22" y="28" width="76" height="70" rx="9"/><path d="M22 49h76M42 20v17m36-17v17M43 65h9m17 0h9M43 80h9"/><path class="glyph-accent" d="m69 81 7 7 15-17"/></svg> : <svg viewBox="0 0 120 120" fill="none"><path d="M44 27H29a7 7 0 0 0-7 7v60a7 7 0 0 0 7 7h62a7 7 0 0 0 7-7V34a7 7 0 0 0-7-7H76"/><rect x="44" y="18" width="32" height="20" rx="5"/><path d="M39 78h42m-42 9h29"/><path class="glyph-accent" d="M60 47v20M50 57h20"/></svg>}</div><div class="visual-bottom"><span>CASO DE EXPERIENCIA LABORAL</span><Icon name="code" size={20} /></div></div>
          <div class="project-content"><h3>{project.title}</h3><p>{project.description}</p><p class="project-detail">{project.detail}</p><div class="tags">{project.stack.map(tech => <span>{tech}</span>)}</div><div class="project-note"><span></span>{project.note}</div></div>
        </article>)}</div>
      </section>

      <section class="about-section" aria-labelledby="about-title"><div class="container about-grid"><div><p class="eyebrow">UN POCO SOBRE MÍ</p><h2 id="about-title">Más que tecnologías,<br /><span class="muted">resolver problemas.</span></h2></div><div class="about-copy"><p>{profile.about}</p><p>Complemento mi formación con conocimientos en Docker, Kubernetes, CI/CD y arquitectura de software para el despliegue y mantenimiento de aplicaciones modernas.</p><div class="about-signature"><span class="signature-mark">MM</span><div><strong>{profile.name}</strong><span>Desarrollador Full Stack · {profile.location}</span></div></div></div></div></section>

      <section class="section container experience-grid" id="experiencia" aria-labelledby="experience-title"><div class="experience-intro"><p class="eyebrow">02 / MI RECORRIDO</p><h2 id="experience-title">Experiencia que<br />conecta.</h2><p>Desarrollo de software, sistemas informáticos e infraestructura: una perspectiva técnica integral.</p><a class="text-link" href="#contacto">Conversemos sobre tu equipo <Icon name="arrow" size={17} /></a></div><div class="timeline">{experience.map((job, i) => <article class={`timeline-item ${i === 0 ? 'current' : ''}`}><span class="timeline-dot"></span><div class="job-meta"><span>{job.date}</span><span>{job.location}</span></div><h3>{job.role}</h3><p class="job-company">{job.company}</p><p class="job-description">{job.description}</p><div class="tags">{job.tags.map(tag => <span>{tag}</span>)}</div></article>)}</div></section>

      <section class="stack-section" id="stack" aria-labelledby="stack-title"><div class="container"><div class="section-heading"><div><p class="eyebrow">03 / CAJA DE HERRAMIENTAS</p><h2 id="stack-title">El stack detrás de cada solución.</h2></div><p>Tecnologías, herramientas y conocimientos<br />que forman parte de mi recorrido.</p></div><div class="skills-grid">{stack.map((group, i) => <article class="skill-card"><span class="skill-index">0{i + 1}</span><Icon name={i === 0 ? 'code' : i === 3 ? 'layers' : i === 2 ? 'check' : 'book'} size={25} /><h3>{group.title}</h3><p>{group.subtitle}</p><div class="skill-tags">{group.items.map(item => <span>{item}</span>)}</div></article>)}</div><p class="section-footnote">Las herramientas complementarias incluyen conocimientos y formación; no implican el mismo nivel de experiencia profesional.</p></div></section>

      <section class="section container" id="formacion" aria-labelledby="education-title"><div class="section-heading"><div><p class="eyebrow">04 / APRENDIZAJE CONTINUO</p><h2 id="education-title">Una base sólida. Curiosidad constante.</h2></div></div><div class="education-grid">{education.map(item => <article class="education-card"><div class="education-icon"><Icon name="book" size={24} /></div><div><p class="eyebrow">{item.type}</p><h3>{item.title}</h3><p>{item.institution}</p><span class="education-detail">{item.detail}</span></div></article>)}</div>
        <div class="courses-heading"><h3>Cursos y certificaciones</h3><span>Una selección de mi formación complementaria</span></div><div class="featured-courses">{featured.map(course => <article class="course-card"><span class="course-check"><Icon name="check" size={17} /></span><div><span class="course-category">{course.category}</span><h4>{course.name}</h4></div></article>)}</div>
        <details class="course-catalog"><summary><span>Explorar toda mi formación <span class="course-count">{courses.length} cursos y talleres</span></span><span class="details-plus" aria-hidden="true">+</span></summary><div class="catalog-content"><p class="catalog-note">Listado basado en el CV de junio de 2026. No se incluyen fechas, entidades emisoras o enlaces de verificación que no figuran en el documento.</p><div class="filter-buttons" role="group" aria-label="Filtrar cursos por categoría"><button class="active" data-filter="Todos" aria-pressed="true">Todos</button>{categories.map(category => <button data-filter={category} aria-pressed="false">{category}</button>)}</div><p id="course-results" class="sr-only" aria-live="polite">{courses.length} cursos</p><ul class="course-list">{courses.map(course => <li data-category={course.category}><span>{course.name}</span><span>{course.category}</span></li>)}</ul></div></details>
      </section>

      <section class="contact-section" id="contacto" aria-labelledby="contact-title"><div class="container contact-grid"><div><div class="availability"><span></span> Disponible para trabajar</div><h2 id="contact-title">El próximo proyecto<br />empieza con un <span>hola.</span></h2><p>¿Buscas un desarrollador Full Stack para tu equipo?<br />Conversemos sobre cómo puedo aportar.</p><a class="button primary" href={`mailto:${profile.email}`}>Escríbeme <Icon name="arrow" size={18} /></a></div><div class="contact-options"><a class="contact-row" href={`mailto:${profile.email}`}><span class="contact-icon"><Icon name="mail" size={22} /></span><div><span>CORREO ELECTRÓNICO</span><strong>{profile.email}</strong></div><Icon name="arrow" size={18} /></a><button class="copy-email" data-email={profile.email}><Icon name="copy" size={14} /><span>Copiar correo</span></button><p id="copy-status" class="sr-only" role="status"></p><a class="contact-row" href={`tel:${profile.phoneLink}`}><span class="contact-icon"><Icon name="phone" size={22} /></span><div><span>TELÉFONO</span><strong>{profile.phone}</strong></div><Icon name="arrow" size={18} /></a><div class="contact-row location-row"><span class="contact-icon"><Icon name="pin" size={22} /></span><div><span>UBICACIÓN</span><strong>{profile.location}</strong></div></div></div></div></section>
    </main>
    <footer class="container footer"><a class="brand" href="#inicio"><span class="brand-mark">m<span>.</span></span><span>Marco Mamani</span></a><p>Desarrollador Full Stack · {new Date().getFullYear()}</p><a class="back-top" href="#inicio">Volver arriba <span>↑</span></a></footer>
    <script>
      const themeToggle = document.querySelector<HTMLButtonElement>('#theme-toggle');
      function updateThemeLabel() {
        const dark = document.documentElement.dataset.theme === 'dark';
        themeToggle?.setAttribute('aria-label', dark ? 'Activar modo claro' : 'Activar modo oscuro');
      }
      updateThemeLabel();
      themeToggle?.addEventListener('click', () => {
        const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = theme;
        try { localStorage.setItem('theme', theme); } catch {}
        updateThemeLabel();
      });
      const menu = document.querySelector<HTMLButtonElement>('#menu-toggle');
      const nav = document.querySelector('#navigation');
      function closeMenu() { nav?.classList.remove('open'); menu?.setAttribute('aria-expanded', 'false'); menu?.setAttribute('aria-label', 'Abrir menú'); }
      menu?.addEventListener('click', () => {
        const open = nav?.classList.toggle('open');
        menu.setAttribute('aria-expanded', String(Boolean(open)));
        menu.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
      });
      nav?.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));
      document.addEventListener('keydown', event => { if (event.key === 'Escape') { closeMenu(); } });
      const filters = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
      filters.forEach(button => button.addEventListener('click', () => {
        filters.forEach(filter => { filter.classList.toggle('active', filter === button); filter.setAttribute('aria-pressed', String(filter === button)); });
        let count = 0;
        document.querySelectorAll<HTMLElement>('[data-category]').forEach(item => {
          item.hidden = button.dataset.filter !== 'Todos' && item.dataset.category !== button.dataset.filter;
          if (!item.hidden) count++;
        });
        const status = document.querySelector('#course-results');
        if (status) status.textContent = `${count} cursos en ${button.dataset.filter}`;
      }));
      document.querySelector<HTMLButtonElement>('.copy-email')?.addEventListener('click', async event => {
        const button = event.currentTarget as HTMLButtonElement;
        const label = button.querySelector('span');
        const status = document.querySelector('#copy-status');
        try {
          await navigator.clipboard.writeText(button.dataset.email || '');
          if (label) label.textContent = '¡Correo copiado!';
          if (status) status.textContent = 'Correo copiado al portapapeles.';
          setTimeout(() => { if (label) label.textContent = 'Copiar correo'; }, 2500);
        } catch { if (status) status.textContent = 'No se pudo copiar. Selecciona el correo o pulsa el enlace para escribir.'; }
      });
    </script>
  </body>
</html>
